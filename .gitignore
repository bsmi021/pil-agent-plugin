# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Reference images used for local validation.
# These are derived from a private source image and are deliberately not
# published. Tests that depend on one regenerate it in-process; the six tests
# that need the original skip when it is absent. See tests/conftest.py.
runs/**/*.png
reference/

# Local credentials must never enter a plugin package.
.env
.env.*
!.env.example
.npmrc
.pypirc
*.key
*.p12
*.pfx
credentials.json
service-account*.json
