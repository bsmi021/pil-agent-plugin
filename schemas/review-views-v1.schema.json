{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsmi021/pil-agent-plugin/schemas/review-views-v1.schema.json",
  "title": "PIL Agent matched review views v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "views"],
  "properties": {
    "schema": {"const": "review-views-v1"},
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reference", "render"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "reference": {"type": "string", "minLength": 1},
          "render": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
