{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsmi021/pil-agent-plugin/schemas/correspondences-v1.schema.json",
  "title": "PIL Agent calibrated view correspondences v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "views"],
  "properties": {
    "schema": {"const": "correspondences-v1"},
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "projection_matrix", "landmarks"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "projection_matrix": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
          "offset": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "landmarks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["vertex", "target"],
              "properties": {
                "vertex": {"type": "integer", "minimum": 0},
                "target": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
                "weight": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          },
          "silhouette_vertices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "silhouette_weight": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
