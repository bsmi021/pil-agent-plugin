{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsmi021/pil-agent-plugin/schemas/template-mesh-v1.schema.json",
  "title": "PIL Agent template mesh v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "vertices", "faces"],
  "properties": {
    "schema": {"const": "template-mesh-v1"},
    "vertices": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false}
    },
    "faces": {
      "type": "array",
      "items": {"type": "array", "minItems": 3, "items": {"type": "integer", "minimum": 0}}
    }
  }
}
