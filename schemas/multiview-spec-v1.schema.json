{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsmi021/pil-agent-plugin/schemas/multiview-spec-v1.schema.json",
  "title": "PIL Agent multi-view image specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "views"],
  "properties": {
    "schema": {"const": "multiview-spec-v1"},
    "contour_epsilon_fraction": {"type": "number", "minimum": 0, "maximum": 0.1},
    "foreground": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"background_delta": {"type": "number", "minimum": 0}}
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "image"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "image": {"type": "string", "minLength": 1},
          "landmarks": {"type": "object"}
        }
      }
    }
  }
}
